# Copy to .env.local for local development. Every variable is optional locally:
# without them Plantr uses a local SQLite file, prints emails to the console and plans
# gardens with its rule-based designer instead of AI.

# --- AI (Anthropic Claude) ---------------------------------------------------
# Enables photo analysis, AI garden design and "Ask Plantr".
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
# PLANTR_MODEL=claude-opus-5-5

# --- Database (libSQL / Turso) ---------------------------------------------
# Local default: file:local.db. In production use a Turso database URL + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Auth & email ----------------------------------------------------------
# Required in production: signs unsubscribe links. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL used in emailed links (required in production), e.g. https://plantr.app
APP_URL=http://localhost:3000
# Resend (https://resend.com) for sign-in links and the weekly digest.
RESEND_API_KEY=
EMAIL_FROM="Plantr <garden@your-domain.com>"

# --- Cron ------------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/weekly-digest.
CRON_SECRET=
