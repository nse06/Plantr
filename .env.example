# Copy to .env.local for local development. Every variable is optional locally:
# without them Plantr uses a local SQLite file, prints emails to the console and plans
# gardens with its rule-based designer instead of AI.

# --- AI (Anthropic Claude) ---------------------------------------------------
# Enables photo analysis, AI garden design and "Ask Plantr".
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
# PLANTR_MODEL=claude-opus-5-5

# --- AI cost controls (all optional) ------------------------------------------
# When to call the AI garden designer: "smart" (default: only when there's a photo or
# typed notes; otherwise the free rule-based designer), "always" or "never".
# PLANTR_AI_DESIGN=smart
# Reasoning effort per feature: low | medium | high. Defaults: photo low, design medium, ask low.
# Compare settings on sample gardens first with: npm run ai:sweep
# PLANTR_DESIGN_EFFORT=medium
# PLANTR_PHOTO_EFFORT=low
# PLANTR_ASK_EFFORT=low
# Model per feature (defaults to PLANTR_MODEL).
# PLANTR_DESIGN_MODEL=
# PLANTR_PHOTO_MODEL=
# PLANTR_ASK_MODEL=
# Estimated daily AI spend cap in USD. Once reached, plans use the rule-based designer until
# midnight UTC. Default 10; "off" removes the cap. Also set a monthly limit in the Claude Console.
# PLANTR_AI_DAILY_BUDGET_USD=10
# Set to "off" to skip the AI result cache (7 days for designs, 30 for photos).
# PLANTR_AI_CACHE=on

# --- Database (libSQL / Turso) ---------------------------------------------
# Local default: file:local.db. In production use a Turso database URL + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Auth & email ----------------------------------------------------------
# Required in production: signs unsubscribe links. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL used in emailed links (required in production), e.g. https://plantr.app
APP_URL=http://localhost:3000
# Resend (https://resend.com) for sign-in links and the weekly digest.
RESEND_API_KEY=
EMAIL_FROM="Plantr <garden@your-domain.com>"

# --- Cron ------------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/weekly-digest.
CRON_SECRET=
